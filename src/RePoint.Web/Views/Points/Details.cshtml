@model CollectionPoint
@{ ViewData["Title"] = Model.Name; }
<h1>@Model.Name</h1><p class="muted">Демонстрационен пункт — не посещавайте посочения адрес.</p>
<dl class="details"><dt>Град</dt><dd>@Model.City</dd><dt>Адрес</dt><dd>@Model.Address</dd><dt>Работно време</dt><dd>@Model.OpeningHours</dd></dl>
<h2>Приемани материали</h2><ul>@foreach(var m in Model.AcceptedMaterials.Where(x => x.IsAccepted)) { <li>@m.Material.Name</li> }</ul>
<a class="btn" asp-controller="Requests" asp-action="Create">Създай заявка</a>
